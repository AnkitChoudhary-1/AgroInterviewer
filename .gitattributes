# Normalize line endings to LF in the repo, check out as-is on Windows
* text=auto

*.kt text eol=lf
*.kts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.properties text eol=lf
gradlew text eol=lf

*.bat text eol=crlf

*.jar binary
*.png binary
*.webp binary
*.apk binary
*.aab binary
